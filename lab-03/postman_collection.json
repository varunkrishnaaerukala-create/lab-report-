    {
      "name": "09. Sort books in ascending order (ASC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Books are sorted in ASC order by price', function () {",
              "    var jsonData = pm.response.json();",
              "    for (var i = 1; i < jsonData.data.length; i++) {",
              "        pm.expect(jsonData.data[i].price).to.be.at.least(jsonData.data[i - 1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=ASC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "ASC" }
          ]
        }
      }
    },
